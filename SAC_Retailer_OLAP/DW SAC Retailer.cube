  <Source dwd:design-time-name="2403947c-093d-4259-8bd8-fd3e5d8d603e">
    <DataSourceViewID>DW SAC Retailer</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="a71c91d4-5260-420f-82ee-4a8a17e64396">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/



CALCULATE;

/* 1. Margen de Beneficio */
CREATE MEMBER CURRENTCUBE.[Measures].[Margen de Beneficio]
AS IIF(
    [Measures].[Sales] = 0,
    NULL,
    [Measures].[Profit] / [Measures].[Sales]
),
FORMAT_STRING = "Percent",
VISIBLE = 1;

/* 2. Rentabilidad sobre Compras */
CREATE MEMBER CURRENTCUBE.[Measures].[Rentabilidad sobre Compras]
AS IIF(
    [Measures].[Purchasing Costs] = 0,
    NULL,
    [Measures].[Profit] / [Measures].[Purchasing Costs]
),
FORMAT_STRING = "Percent",
VISIBLE = 1;

/* 3. Descuento Promedio */
CREATE MEMBER CURRENTCUBE.[Measures].[Descuento Promedio]
AS IIF(
    [Measures].[Recuento Fact Ventas] = 0,
    NULL,
    [Measures].[Discount] /
    [Measures].[Recuento Fact Ventas]
),
FORMAT_STRING = "Percent",
VISIBLE = 1;

/* 4. Crecimiento Mensual de Ventas */
CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento Mensual de Ventas]
AS IIF(
    [Order Date].[Calendario].CurrentMember.Level
        IS [Order Date].[Calendario].[Month],

    IIF(
        IsEmpty(
            (
                [Measures].[Sales],
                [Order Date].[Calendario].CurrentMember.PrevMember
            )
        )
        OR
        (
            [Measures].[Sales],
            [Order Date].[Calendario].CurrentMember.PrevMember
        ) = 0,

        NULL,

        (
            [Measures].[Sales]
            -
            (
                [Measures].[Sales],
                [Order Date].[Calendario].CurrentMember.PrevMember
            )
        )
        /
        (
            [Measures].[Sales],
            [Order Date].[Calendario].CurrentMember.PrevMember
        )
    ),

    NULL
),
FORMAT_STRING = "Percent",
VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>